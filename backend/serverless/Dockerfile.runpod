# Образ для Runpod Serverless (GPU, посекундная оплата, $0 за простой).
# Сборка ИЗ ПАПКИ backend/:
#   docker build -f serverless/Dockerfile.runpod -t <dockerhub-user>/kzsub-runpod:v1 .
#   docker push <dockerhub-user>/kzsub-runpod:v1
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt runpod

# Веса large-v3 НЕ запекаем в образ — образ остаётся лёгким (~2 ГБ вместо
# ~8 ГБ), пуллится за секунды на новом воркере. Модель (3 ГБ) хранится на
# подключённом Runpod Network Volume (/runpod-volume) и качается туда ОДИН РАЗ
# при первом запуске воркера, дальше переиспользуется всеми холодными стартами.
# См. docs/HOSTING.md -> "Network Volume".
ENV HF_HOME=/runpod-volume/hf-cache

COPY app ./app
COPY serverless ./serverless

ENV KZSUB_DEVICE=cuda \
    KZSUB_COMPUTE_TYPE=float16 \
    KZSUB_WHISPER_MODEL=large-v3

CMD ["python3", "serverless/runpod_handler.py"]
