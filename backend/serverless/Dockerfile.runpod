# Образ для Runpod Serverless (GPU, посекундная оплата, $0 за простой).
# Сборка ИЗ ПАПКИ backend/:
#   docker build --platform linux/amd64 -f serverless/Dockerfile.runpod \
#       -t <dockerhub-user>/kzsub-runpod:v2 .
#   docker push <dockerhub-user>/kzsub-runpod:v2
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt runpod

# Веса large-v3 НЕ запекаем: образ остаётся лёгким (~2 ГБ) и пуллится за секунды
# на любом новом воркере. Модель (3 ГБ) хранится на подключённом Runpod Network
# Volume (/runpod-volume) и качается туда ОДИН РАЗ при первом старте, дальше
# переиспользуется всеми холодными стартами. См. docs/DECISIONS.md ADR-12
# и docs/HOSTING.md -> "Network Volume".
# ВАЖНО: том создавать в дата-центре с ХОРОШИМ запасом GPU (не в дефицитном).
ENV HF_HOME=/runpod-volume/hf-cache

COPY app ./app
COPY serverless ./serverless

ENV KZSUB_DEVICE=cuda \
    KZSUB_COMPUTE_TYPE=float16 \
    KZSUB_WHISPER_MODEL=large-v3

CMD ["python3", "serverless/runpod_handler.py"]
