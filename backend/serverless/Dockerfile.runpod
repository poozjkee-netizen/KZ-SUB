# Образ для Runpod Serverless (GPU, посекундная оплата, $0 за простой).
# Сборка ИЗ ПАПКИ backend/:
#   docker build --platform linux/amd64 -f serverless/Dockerfile.runpod \
#       -t <dockerhub-user>/kzsub-runpod:v2 .
#   docker push <dockerhub-user>/kzsub-runpod:v2
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt runpod

# СТРАТЕГИЯ (см. docs/DECISIONS.md ADR-13):
# - веса НЕ запекаем -> образ лёгкий (~2 ГБ), пуллится за секунды;
# - Network Volume НЕ используем -> эндпоинт не привязан к одному дата-центру,
#   можно разрешить ЛЮБОЙ ДЦ и все типы 24GB-карт => максимум доступности GPU;
# - модель качается с HuggingFace при старте воркера (быстрый CDN, ~1-2 мин),
#   в кэш на эфемерном диске контейнера; FlashBoot держит воркер тёплым между
#   роликами, редкий холодный старт смягчён «подсказками терпения» в панели.
# HF_HOME оставляем дефолтным (/root/.cache/huggingface) — на локальном диске.

COPY app ./app
COPY serverless ./serverless

ENV KZSUB_DEVICE=cuda \
    KZSUB_COMPUTE_TYPE=float16 \
    KZSUB_WHISPER_MODEL=large-v3

CMD ["python3", "serverless/runpod_handler.py"]
