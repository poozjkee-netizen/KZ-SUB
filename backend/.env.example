# NP SUB backend — пример конфигурации.
# Скопируй в .env (или задай как секреты Fly) и подставь свои значения.
# Все переменные читаются в app/config.py. Префикс обязателен: KZSUB_.
# Файл .env в git НЕ коммитим (см. .gitignore).

# ── Модель / устройство ─────────────────────────────────────────────
KZSUB_WHISPER_MODEL=large-v3        # для казахского минимум large-v3
KZSUB_DEVICE=cpu                    # cpu | cuda (на GPU-воркере — cuda)
KZSUB_COMPUTE_TYPE=int8             # int8 (cpu) | float16 (gpu)
KZSUB_LANGUAGE=kk                   # язык зафиксирован — казахский

# ── Декодирование Whisper (transcribe.py, живёт в ВОРКЕРЕ!) ──────────
# Чтобы подействовало в проде, нужна ПЕРЕСБОРКА GPU-образа Runpod,
# одного fly deploy недостаточно (см. золотое правило в CLAUDE.md).
KZSUB_CONDITION_ON_PREVIOUS_TEXT=false  # главный источник «выдуманных слов»:
                                    # модель продолжает свою же галлюцинацию
KZSUB_NO_SPEECH_THRESHOLD=0.6       # выше — агрессивнее выбрасывать текст из тишины
KZSUB_LOG_PROB_THRESHOLD=-1.5       # отсев сегментов с низкой уверенностью (-1.0 режет казахскую речь)
KZSUB_COMPRESSION_RATIO_THRESHOLD=2.4   # ловит зацикленный повторяющийся бред
KZSUB_HALLUCINATION_SILENCE_THRESHOLD=0    # пропускать тишину длиннее N сек (выкл: уносил настоящую речь)
KZSUB_VAD_SPEECH_PAD_MS=200         # паддинг VAD; штатные 400 мс = субтитр раньше слова
KZSUB_VAD_MIN_SILENCE_MS=400        # пауза для деления речи на фрагменты
KZSUB_VAD_THRESHOLD=0.35            # чувствительность VAD (ниже — не терять тихую речь)
# Код-свитчинг: в казахской речи проскакивают русские слова, а модель с
# language=kk пишет их «по-казахски» («конечно» -> «кәнешне»). Короткая затравка
# со смешанной речью склоняет писать их по-русски. ПУСТО = выключено; готовое
# значение ниже включай и сверяй по WER — затравка может подмешаться в текст.
KZSUB_INITIAL_PROMPT=
# Готовый текст — config.MIXED_SPEECH_PROMPT (его же ставит
# scripts/transcribe-local.py --prompt-mixed):
# Бүгін, кстати, вообще қызық болды. Конечно, жалғастырамыз. Короче, монтаж дайын, и всё готово.
KZSUB_HOTWORDS=                     # редкие слова/имена через запятую

# ── Лицензии и ключи (licenses.py, SQLite) ──────────────────────────
# Тестовых ключей по умолчанию БОЛЬШЕ НЕТ. Лицензии живут в БД (licenses.py);
# выдаются CLI: python -m app.licenses create --type subscription --minutes 300 --days 30
#
# Секретный ключ разработчика: бессрочная безлимитная лицензия без квот.
# Задай в Fly secrets (в git/чат не попадает). Пусто = нет dev-доступа.
KZSUB_DEVELOPER_KEY=
# Бутстрап-ключи "ключ:тариф,ключ2:тариф2" (free|pro|studio) — заносятся в БД
# при старте, если их там нет (для ключей, выданных вручную). Пусто = ничего.
KZSUB_API_KEYS=
# Путь к БД лицензий. Пусто = STATE_DIR/licenses.db (Fly-том), иначе TMP_DIR.
KZSUB_LICENSE_DB=
KZSUB_FREE_MINUTES_PER_MONTH=30
KZSUB_MAX_AUDIO_SECONDS=600         # лимит длительности файла (сек) = 10 минут
                                    # длинные файлы шлюз режет на куски (см. ниже)
KZSUB_CHUNK_SECONDS=180             # длина куска при нарезке длинного аудио (сек);
                                    # каждый кусок после base64 должен влезать в
                                    # лимит Runpod 10 MiB (16kHz mono: 180с ≈ 7.7МБ)
KZSUB_CHUNK_CONCURRENCY=3           # сколько кусков гнать в Runpod одновременно;
                                    # выигрыш ограничен Max Workers эндпоинта Runpod

# ── Анти-шаринг: привязка ключа к устройствам ───────────────────────
KZSUB_MAX_DEVICES_PER_KEY=2         # 0 = проверка выключена
KZSUB_STATE_DIR=                    # где хранить привязки; на Fly = /data (том). Пусто = в памяти.

# ── Прокси-режим: Runpod Serverless GPU ─────────────────────────────
# Если заданы ОБА (endpoint_id + api_key) — /transcribe уходит в Runpod,
# иначе Whisper крутится локально. Шлюз на Fly работает в прокси-режиме.
KZSUB_RUNPOD_ENDPOINT_ID=
KZSUB_RUNPOD_API_KEY=
KZSUB_RUNPOD_WORKER_KEY=gateway-internal   # должен совпадать с KZSUB_API_KEYS воркера
KZSUB_RUNPOD_TIMEOUT_SECONDS=900           # ожидание результата, включая холодный старт

# ── Нарезка субтитров ───────────────────────────────────────────────
KZSUB_CAPTION_STYLE=word            # word (караоке) | phrase (фразы)
KZSUB_GLUE_MAX_CHARS=2              # (word) короткие слова липнут к следующему
KZSUB_MAX_LINE_CHARS=42            # (phrase) макс. символов в строке
KZSUB_MAX_LINES=2                  # (phrase) макс. строк в реплике
KZSUB_MAX_CUE_SECONDS=7.0          # (phrase) макс. длительность реплики
KZSUB_MAX_GAP_SECONDS=0.8          # пауза для разрыва реплики

# ── Оформление ──────────────────────────────────────────────────────
KZSUB_UPPERCASE=false               # ВЕРХНИЙ регистр
KZSUB_STRIP_PUNCTUATION=true        # убирать пунктуацию (караоке-стиль)
KZSUB_PHRASE_PUNCTUATION=true       # во фразах пунктуацию оставляем
KZSUB_PUNCT_KEEP=!                  # какие знаки оставить при очистке

# ── Тайминги (timing.py, на шлюзе) ──────────────────────────────────
KZSUB_SNAP_TO_SPEECH=false          # подтягивать начало реплики к началу речи;
                                    # ВЫКЛ по умолчанию — на реальном материале
                                    # сделало хуже, корень лечится VAD-паддингом выше
KZSUB_SNAP_WINDOW_SECONDS=1.0       # как далеко вперёд искать речь (0 = выключить)

# ── Постобработка текста (postprocess.py, на шлюзе) ─────────────────
KZSUB_MAX_REPEATS=3                 # макс. одинаковых реплик подряд (0 = выкл);
                                    # Whisper на тишине залипает и повторяет слово
KZSUB_MAX_CUE_DROP_SECONDS=0        # отбрасывать реплики длиннее N сек (0 = выкл)
KZSUB_LEXICON=                      # словарь правок "было=стало,было2=стало2"
                                    # (пустая правая часть удаляет слово)
# ── Метрики (events.py) ─────────────────────────────────────────────
KZSUB_ANALYTICS=true                # учёт прогонов: минуты, отказы, время
KZSUB_EVENTS_DB=                    # пусто = STATE_DIR/events.db
KZSUB_COLLECT_DATASET=false         # сбор датасета речи под дообучение
KZSUB_COLLECT_KEYS=                 # чьи прогоны собирать (пусто = ничьи)
KZSUB_DATASET_MAX_MB=300            # потолок объёма; старые записи вытесняются

# ── Напоминания клиентам (notify.py, канал — Telegram-бот) ──────────
KZSUB_NOTIFY_ENABLED=true           # предупреждать о лимите и сроке
KZSUB_NOTIFY_DAYS_BEFORE=3          # за сколько дней до конца подписки
KZSUB_NOTIFY_MIN_MINUTES=5          # остаток минут для предупреждения
KZSUB_NOTIFY_INTERVAL_HOURS=6       # период фоновой проверки (0 = вручную)

KZSUB_LEXICON_PATH=                 # файл со словарём (строка на правило, # = коммент)
# Готовый словарь каз-рус вставок едет в образе шлюза:
# KZSUB_LEXICON_PATH=/app/lexicon-kk-ru.txt

# ── Telegram-бот выдачи ключей (telegram_bot.py) ────────────────────
# Токен от @BotFather. НЕ коммить реальный токен — только Fly secrets.
# Пусто = вебхук /telegram/webhook отключён (404).
KZSUB_TELEGRAM_BOT_TOKEN=
# Секрет вебхука (сверяется с заголовком от Telegram). Сгенерируй случайную
# строку и передай её же в `python -m app.telegram_bot set-webhook`.
KZSUB_TELEGRAM_WEBHOOK_SECRET=
# Telegram ID продавца(ов) через запятую — кто подтверждает оплату Standard.
# Узнать свой ID: команда /whoami у бота.
KZSUB_TELEGRAM_ADMIN_IDS=
# Номер/реквизит Kaspi, который бот показывает клиенту в /buy.
KZSUB_KASPI_PHONE=
# Путь к БД языка бота (пусто = STATE_DIR/bot_users.db).
KZSUB_BOT_USERS_DB=
# Ссылка на лендинг — бот показывает её в приветствии и /buy.
KZSUB_LANDING_URL=https://poozjkee-netizen.github.io/KZ-SUB/

# ── Прочее ──────────────────────────────────────────────────────────
KZSUB_TMP_DIR=tmp
